specification {
  element system
  element container
  element component
  element client
}

model {
    browser = client 'Browser' {
        style {
            shape browser
        }
    }

    app = container 'App' {
        technology 'Node.js / Alpine Linux'
        icon tech:nodejs

        frontend = component 'Frontend' {
            technology 'React'
            icon tech:react
        }

        server = component 'Web Server' {
            technology 'Fastify'
            icon tech:fastify
        }

        server -> frontend 'serves'
    }

    runtime = container 'Runtime' {
        technology 'Node.js'
        icon tech:nodejs
    }

    database = container 'Database' {
        technology 'PostgreSQL'
        icon tech:postgresql
        style {
            shape storage
        }
    }

    valkey = container 'Valkey' {
        technology 'Valkey'
        icon https://valkey.io/img/Valkey-logo.svg
        style {
            shape storage
        }
    }

    bucket = container 'S3 Bucket' {
        technology 'Amazon S3'
        icon aws:simple-storage-service
        style {
            shape bucket
        }
    }

    smtp = container 'SMTP Server' {
        technology 'SMTP'
        icon bootstrap:envelope
    }

    browser -> app.server 'Request frontend' {
        technology 'HTTPS'
    }

    browser -> app.server 'API' {
        technology 'HTTPS'
    }

    browser -> app.server 'Chat / Lobby' {
        technology 'WebSocket'
    }

    browser -> app.server 'Colyseus Gameplay' {
        technology 'WebSocket'
    }

    app -> runtime 'Manage Rooms' {
        technology 'HTTP'
    }

    app -> runtime 'Proxy Client Game Connection' {
        technology 'WebSocket'
    }

    runtime -> app 'Load plugins, Report readiness, Save/restore games, Submit results' {
        technology 'HTTP'
    }
}