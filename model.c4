specification {
  element system
  element container
  element component
  element client
  relationship http {
    color blue
    line solid
  }
  relationship socketio {
    color amber
    line dashed
  }
  relationship colyseus {
    color green
    line dashed
  }
}

model {
    browser = client 'Browser' {
        style {
            shape browser
        }
    }

    app = container 'App' {
        technology 'Node.js / Alpine Linux'
        icon tech:nodejs

        frontend = component 'Frontend' {
            technology 'React'
            icon tech:react
        }

        server = component 'Web Server' {
            technology 'Fastify'
            icon tech:fastify
        }

        server -> frontend 'serves'
    }

    runtime = container 'Runtime' {
        technology 'Node.js'
        icon tech:nodejs
    }

    database = container 'Database' {
        technology 'PostgreSQL'
        icon tech:postgresql
        style {
            shape storage
        }
    }

    valkey = container 'Valkey' {
        technology 'Valkey'
        icon https://valkey.io/img/Valkey-logo.svg
        style {
            shape storage
        }
    }

    bucket = container 'S3 Bucket' {
        technology 'Amazon S3'
        icon aws:simple-storage-service
        style {
            shape bucket
        }
    }

    smtp = container 'SMTP Server' {
        technology 'SMTP'
        icon bootstrap:envelope
    }

    browser -[http]-> app.server 'Request frontend' {
        technology 'HTTPS'
    }

    browser -[http]-> app.server 'API' {
        technology 'HTTPS'
    }

    browser -[socketio]-> app.server 'Chat / Lobby' {
        technology 'Socket.IO'
    }

    browser -[colyseus]-> app.server 'Gameplay connection' {
        technology 'Colyseus / WebSocket'
        description 'Gameplay data flows through App to the owning Runtime process.'
    }

    app -[http]-> runtime 'Manage Rooms' {
        technology 'HTTP'
    }

    app -[colyseus]-> runtime 'Gameplay connection' {
        technology 'Colyseus / WebSocket'
        description 'App proxies the same gameplay data between the browser and the owning Runtime process.'
    }

    runtime -[http]-> app 'Load plugins, Report readiness, Save/restore games, Submit results' {
        technology 'HTTP'
    }
}