model {
  player = actor 'Player' {
    description 'Signs in, browses approved games, uses lobby/chat, and plays singleplayer or multiplayer matches.'
  }

  admin = actor 'Instance Admin' {
    description 'Registers GitHub catalogs, installs game versions, and approves server plugins for activation.'
  }

  operator = actor 'Operator' {
    description 'Operates the instance, secrets, backups, and performs controlled Game Server pool restarts and scaling.'
  }

  browser = client 'Browser' {
    description 'Runs the React platform shell on the platform origin and each game inside a sandboxed iframe on a separate games origin.'
  }

  app = container 'App' {
    technology 'Node.js / Fastify'
    icon tech:nodejs
    description 'Modular monolith handling auth, REST API, Lobby/Chat (Socket.IO), plugin management, BullMQ jobs, game WebSocket proxy, asset serving, and the authenticated Runtime API. Scales to 1..n identical replicas.'
  }

  runtime = container 'Runtime' {
    technology 'Node.js / Colyseus'
    icon tech:nodejs
    description 'Game Server pool hosting authoritative Colyseus rooms and approved server plugins. Scales independently (1..n); each room belongs to one owning process.'
  }

  database = container 'Database' {
    #storage
    technology 'PostgreSQL'
    icon tech:postgresql
    description 'Shared source of truth for accounts, sessions, roles, catalogs, install jobs, chat, matches, results, and confirmed snapshots.'
    style {
      shape storage
    }
  }

  valkey = container 'Valkey' {
    #storage
    technology 'Valkey'
    icon https://valkey.io/img/Valkey-logo.svg
    description 'Internal coordination for Socket.IO streams, BullMQ queues, Colyseus Presence/Driver, runtime endpoint registration, and rate limits.'
    style {
      shape storage
    }
  }

  bucket = container 'Object Storage' {
    #storage
    technology 'S3-Compatible (Garage)'
    icon aws:simple-storage-service
    description 'Immutable plugin archives, served browser client assets, and media via S3 API.'
    style {
      shape bucket
    }
  }

  smtp = external 'SMTP Server' {
    #external
    technology 'SMTP'
    icon bootstrap:envelope
    description 'Optional operator-provided mail server for account verification and password recovery.'
  }

  github = external 'GitHub' {
    #external
    technology 'Catalogs & Releases'
    icon tech:github
    description 'Hosts official and admin-added game catalog repositories and pre-built .tgz game releases. Not required during gameplay.'
  }

  // Actors
  player -> browser 'Uses platform & plays games'
  admin -> browser 'Manages catalogs & installs games'
  operator -> runtime 'Drains, restarts & scales pool' {
    technology 'Compose / Helm'
  }
}