views {
  view index {
    include *

    include app <-> runtime with {
      multiple true
    }

    include browser <-> app.server with {
      multiple true
    }

    style database, valkey, bucket, smtp {
      color muted
    }
    autoLayout LeftRight
  }

  view app of app {
    include *
  }

  dynamic view gameplay_proxy {
    title 'Gameplay connection'
    browser -[colyseus]-> app 'Gameplay connection'
    app -[colyseus]-> runtime 'Gameplay connection'
  }
}